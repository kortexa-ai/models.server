FROM nvidia/cuda:12.9.0-devel-ubuntu24.04

# Install build essentials and dependencies
# - zlib1g-dev: needed by projects that use uWebSockets (permessage-deflate) and find_package(ZLIB)
# - libssl-dev: TLS support for uWebSockets
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    ccache \
    libcurl4-openssl-dev \
    zlib1g-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Build script that will be run inside container
CMD ["/bin/bash"]
