FROM nvidia/cuda:12.9.0-devel-ubuntu24.04

# Install build essentials and dependencies (match llama.cpp builder)
# - zlib1g-dev: required by uWebSockets (permessage-deflate) and CMake find_package(ZLIB)
# - libssl-dev: required by uWebSockets for TLS
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    ccache \
    libcurl4-openssl-dev \
    zlib1g-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["/bin/bash"]
