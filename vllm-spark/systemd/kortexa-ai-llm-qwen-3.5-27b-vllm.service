[Unit]
Description=Qwen 3.5 27B vLLM (Docker, experimental)
After=network.target docker.service
Requires=docker.service

StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple

User=francip
Group=francip

WorkingDirectory=/home/francip/src/models.server/vllm-spark

Environment=PATH=/home/francip/.local/bin:/home/francip/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

ExecStart=/home/francip/src/models.server/vllm-spark/run-vllm-docker.sh

Restart=always
RestartSec=15

TimeoutStopSec=60

ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/francip/.cache /home/francip/.config /home/francip/.docker /var/run/docker.sock
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
